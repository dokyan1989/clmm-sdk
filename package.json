{
  "name": "danogo-clmm",
  "version": "0.1.6",
  "description": "An SDK to calculate and execute swaps on the Danogo liquidity platform.",
  "main": "./dist/sdk.js",
  "module": "./dist/sdk.mjs",
  "types": "./dist/sdk.d.ts",
  "exports": {
    ".": {
      "import": "./dist/sdk.mjs",
      "require": "./dist/sdk.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "cardano",
    "dano-finance",
    "swap",
    "clmm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dano-finance/clmm-sdk"
  },
  "scripts": {
    "build": "tsup src/sdk.ts --format cjs,esm --dts --minify --clean --no-splitting",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cardano-ogmios/schema": "6.14.0",
    "@evolution-sdk/evolution": "0.3.32"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  }
}
